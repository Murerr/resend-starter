# Copy this file to .env and fill in the values. Never commit .env.

# Create a new key at https://resend.com/api-keys
# ("Sending access" is enough for this project)
RESEND_API_KEY=re_your_new_key_here

# Before your domain is verified, this must be the email address on your Resend account
EMAIL_TO=you@example.com

# Optional. Leave blank to use onboarding@resend.dev until your domain is verified,
# e.g. EMAIL_FROM="Rudy <hello@mail.yourdomain.com>"
EMAIL_FROM=
